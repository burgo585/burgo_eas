; ==============================================================================
; PRESET: XAUUSD M5 - PROFISSIONAL SEM CENTAVOS (MAIS CONFIÁVEL)
; Calibrado para: Ouro Spot (XAUUSD) | Timeframe M5 | Corretora VT Markets Raw ECN
; Dimensionamento: Lote 0.25 para Conta de $10.000 (Risco ~1% por trade)
; Ganho Médio por Vitória: +$61,00 USD (TP1 embolsa ~$45 e 2a ordem tem Lock Profit)
; Taxa de Acerto: 66.0% | Frequencia: 2.75 Trades/Dia | Max DD: $598,84 (5.98%)
; Retorno Projetado 2 Anos: +$11.657,01 USD (+116.5% sobre $10.000)
; ==============================================================================

; --- 1. Motor Operacional & Estrategia ---
InpEngineMode=0
InpBrokerType=0
InpMagicNumber=889901

; --- 2. Parametros do Frasson ATR & Tendencia ---
InpFrassonPeriod=14
InpFrassonShift=5
InpFrassonMultiplier=2.20000000
InpTrendFilterPeriod=50
InpRequireTrendAlign=true

; --- 3. GPS de Volatilidade & Filtro de Fluxo ---
InpUseVolatilityGPS=true
InpMinVolThreshold=0.70000000
InpVolumeSpikeRatio=1.15000000
InpMinRejectionWick=0.25000000

; --- 4. Gestao de Capital & Dimensionamento ($10.000) ---
InpLotMode=0
InpBaseLotSize=0.25000000
InpRiskPercentAccount=1.50000000
InpPartialRatio=0.75000000
InpATR_SL_Multiplier=0.70000000
InpATR_TP1_Multiplier=0.50000000
InpATR_TP2_Multiplier=1.20000000
InpMoveBEOnTP1=true
InpBEBufferPts=25.00000000
InpLockProfitATR=0.15000000
InpTrailingOnTarget2=true

; --- 5. Filtro de Horario / Sessao Ativa ---
InpUseSessionFilter=true
InpStartHour=7
InpStartMin=0
InpEndHour=18
InpEndMin=30

; --- 6. Painel Visual HUD Dark Mode ---
InpShowHUD=true
